; Engine configuration file.
; Tower War — Godot 4.7 project.

config_version=5

[application]

config/name="Tower War"
config/description="Turn-based magical conquest on real city maps."
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.ru.translation", "res://locale/maps/ghent.en.translation", "res://locale/maps/ghent.ru.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
