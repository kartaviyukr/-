# Файл нужен, только если хотите собрать приложение на ДРУГОЙ проект Supabase.
# По умолчанию адрес и публичный ключ уже прописаны в src/lib/supabase.ts,
# и без этого файла всё работает.
#
# Значения берутся на https://supabase.com/dashboard -> ваш проект ->
# Project Settings -> API Keys. Нужен публичный ключ: anon public либо
# Publishable key. Секретный (sb_secret_ / service_role) сюда класть нельзя.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Необязательно: ID проекта Expo (для push-уведомлений через EAS)
EXPO_PUBLIC_EAS_PROJECT_ID=
